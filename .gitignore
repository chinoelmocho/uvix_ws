# --- colcon (se regeneran con `colcon build`) ---
build/
install/
log/

# --- Imágenes locales (las del README sí están en git) ---
images/

# --- VS Code: se comparte la configuración, no la caché ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.vscode/browse.vc.db*
.vscode/ipch/
src/**/.vscode/

# --- Python ---
__pycache__/
*.pyc
*.egg-info/

# --- Mapas pesados de SLAM (>100 MB, GitHub los rechaza) ---
src/Uvix_sim/maps/*.posegraph
src/Uvix_sim/maps/*.data

# --- Bags de ROS y otros temporales ---
*.db3
*.mcap
rosbag2_*/
*.swp
*~
.DS_Store
