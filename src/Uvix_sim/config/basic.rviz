          Color: 0; 255; 0
          Enabled: true
          Name: Range
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /ultrasonic_nav/front_right
