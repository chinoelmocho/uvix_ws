            </material>
        </visual>
        <collision name="wheel_left_collision">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://Uvix_sim/meshes/Rueda_izquierda.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>
