<?xml version="1.0" ?>
<robot name="uvix" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find Uvix_sim)/urdf/materials.xacro" />
    <xacro:include filename="$(find Uvix_sim)/urdf/uvix.gazebo" />


    <link name="base_link">
        <inertial>
            <origin xyz="0.002 0.001 0.426" rpy="0 0 0" />
            <mass value="59.827" />
            <inertia ixx="10.328" ixy="0.0"    ixz="-0.061"
                                  iyy="10.479" iyz="0.25"
                                               izz="2.759" />
        </inertial>
        <visual name="base_link_visual">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://Uvix_sim/meshes/base_link.dae" scale="1 1 1" />
            </geometry>
        </visual>
        <collision name="base_link_collision">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://Uvix_sim/meshes/base_link.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>

    <!-- ===================== RUEDAS DE TRACCIÓN ====================== -->
    <!-- Rueda derecha (VERDE) -->
    <link name="wheel_right_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="2.660" />
            <inertia ixx="0.005" ixy="2.126e-08" ixz="2.319e-07"
                                 iyy="0.005"     iyz="-4.751e-09"
                                                 izz="0.008" />
        </inertial>
        <visual name="wheel_right_visual">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://Uvix_sim/meshes/Rueda_derecha.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="verde_rueda_derecha">
                <color rgba="0.000 1.000 0.000 1.000" />
            </material>
        </visual>
        <collision name="wheel_right_collision">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://Uvix_sim/meshes/Rueda_derecha.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>
    <!-- Rueda izquierda (ROJA) -->
    <link name="wheel_left_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="2.660" />
            <inertia ixx="0.005" ixy="1.382e-08" ixz="-1.931e-07"
                                 iyy="0.005"     iyz="4.234e-09"
                                                 izz="0.008" />
        </inertial>
        <visual name="wheel_left_visual">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://Uvix_sim/meshes/Rueda_izquierda.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="rojo_rueda_izquierda">
