    <!-- ===================== RUEDAS DE TRACCIÓN ====================== -->
    <joint name="base_link_wheel_right_joint" type="continuous">
        <parent link="base_link" />
        <child  link="wheel_right_link" />
        <origin xyz="-0.2365 0.0 0.006" rpy="0 -1.5707963267948966 0" />
        <axis   xyz="0 0 -1" />
    </joint>
    <joint name="base_link_wheel_left_joint" type="continuous">
        <parent link="base_link" />
        <child  link="wheel_left_link" />
        <origin xyz="0.2365 0.0 0.006" rpy="0 -1.5707963267948966 0" />
        <axis   xyz="0 0 -1" />
    </joint>
    <!-- ================ BASE -> CASTERS (giro en Z) =================== -->
    <joint name="base_link_rear_caster_right_joint" type="continuous">
        <parent link="base_link" />
        <child  link="rear_caster_right_link" />
        <origin xyz="-0.112 0.178 0.03" rpy="0 0 0" />
        <axis   xyz="0 0 1" />
    </joint>
    <joint name="base_link_rear_caster_left_joint" type="continuous">
        <parent link="base_link" />
        <child  link="rear_caster_left_link" />
        <origin xyz="0.112 0.178 0.03" rpy="0 0 0" />
        <axis   xyz="0 0 1" />
    </joint>
    <joint name="base_link_front_caster_right_joint" type="continuous">
        <parent link="base_link" />
        <child  link="front_caster_right_link" />
        <origin xyz="-0.112 -0.178 0.03" rpy="0 0 0" />
        <axis   xyz="0 0 1" />
    </joint>
    <joint name="base_link_front_caster_left_joint" type="continuous">
        <parent link="base_link" />
        <child  link="front_caster_left_link" />
        <origin xyz="0.112 -0.178 0.03" rpy="0 0 0" />
        <axis   xyz="0 0 1" />
    </joint>
    <!-- ============== CASTERS -> ROADS (giro en X) =================== -->
    <joint name="rear_caster_right_link_rear_road_right_joint" type="continuous">
        <parent link="rear_caster_right_link" />
        <child  link="rear_road_right_link" />
        <origin xyz="0.0 0.037 -0.071" rpy="0 0 0" />
        <axis   xyz="1 0 0" />
    </joint>
    <joint name="rear_caster_left_link_rear_road_left_joint" type="continuous">
        <parent link="rear_caster_left_link" />
        <child  link="rear_road_left_link" />
        <origin xyz="0.0 0.037 -0.071" rpy="0 0 0" />
        <axis   xyz="1 0 0" />
    </joint>
    <joint name="front_caster_right_link_front_road_right_joint" type="continuous">
        <parent link="front_caster_right_link" />
        <child  link="front_road_right_link" />
        <origin xyz="0.0 0.037 -0.071" rpy="0 0 0" />
        <axis   xyz="1 0 0" />
    </joint>
    <joint name="front_caster_left_link_front_road_left_joint" type="continuous">
        <parent link="front_caster_left_link" />
        <child  link="front_road_left_link" />
        <origin xyz="0.0 0.037 -0.071" rpy="0 0 0" />
        <axis   xyz="1 0 0" />
    </joint>
    <!-- ============== SENSORES ULTRASONICOS =================== -->
    <joint name="base_link_us_front_right_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="us_front_right_link"/>
        <origin xyz="-0.224 -0.224 0.0065" rpy="0 0 -2.35619449"/>
    </joint>
    <joint name="base_link_us_front_left_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="us_front_left_link"/>
        <origin xyz="0.224 -0.224 0.0065" rpy="0 0 -0.78539816"/>
    </joint>
    <joint name="base_link_us_rear_right_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="us_rear_right_link"/>
        <origin xyz="-0.224 0.224 0.0065" rpy="0 0 2.35619449"/>
    </joint>
    <joint name="base_link_us_rear_left_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="us_rear_left_link"/>
        <origin xyz="0.224 0.224 0.0065" rpy="0 0 0.78539816"/>
    </joint>
    <!-- ===================== SENSOR LIDAR====================== -->
    <joint name="base_link_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="lidar_link"/>
        <origin xyz="0.0 -0.23765 0.288" rpy="0 0 -1.5707963267"/>
    </joint>    
    <!-- ===================== CAMARAS ====================== -->
    <joint name="base_link_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="camera_lower_link"/>
        <origin xyz="0.0 -0.28521 0.16279" rpy="0 0 -1.5707963"/>
    </joint>
    <joint name="camera_lower_optical_joint" type="fixed">
        <parent link="camera_lower_link"/>
        <child  link="camera_lower_optical_link"/>
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>
    <joint name="base_link_camera_upper_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="camera_upper_link"/>
        <origin xyz="0.00211 -0.15 1.50562" rpy="0 0 -1.5707963"/>   <!-- ajusta a tu posición -->
    </joint>
    <joint name="camera_upper_optical_joint" type="fixed">
        <parent link="camera_upper_link"/>
        <child  link="camera_upper_optical_link"/>
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>
    <joint name="base_link_camera_aux_front_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="camera_aux_front_link"/>
        <origin xyz="0.0 -0.24305 0.7255" rpy="0 0 -1.5707963"/>
    </joint>
    <joint name="camera_aux_front_optical_joint" type="fixed">
        <parent link="camera_aux_front_link"/>
        <child  link="camera_aux_front_optical_link"/>
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>
    <joint name="base_link_camera_aux_right_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="camera_aux_right_link"/>
        <origin xyz="-0.24305 0.0 0.7255" rpy="0 0 3.1415927"/>
    </joint>
    <joint name="camera_aux_right_optical_joint" type="fixed">
        <parent link="camera_aux_right_link"/>
        <child  link="camera_aux_right_optical_link"/>
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>
     <!-- ===================== FOOTPRINT ====================== -->   
    <joint name="base_footprint_base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child  link="base_link"/>
        <origin xyz="0 0 0.078" rpy="0 0 1.5707963"/>
    </joint>
    <!-- ===================== IMU ====================== -->
    <joint name="base_link_imu_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="imu_link"/>
        <origin xyz="0.000 -0.00122 0.140" rpy="0 0 0"/>   <!-- centro de masa; ajusta si lo montas en otro lugar -->
    </joint>    



    <!-- =============================================================== -->
    <!--  ROS2 CONTROL                                                    -->
    <!-- =============================================================== -->

    <ros2_control name="BobertGazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <!-- Ruedas de tracción -->
        <joint name="base_link_wheel_right_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_link_wheel_left_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Casters (giro en Z) — solo state -->
        <joint name="base_link_rear_caster_right_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_link_rear_caster_left_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_link_front_caster_right_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_link_front_caster_left_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Roads / ruedas locas (giro en X) — solo state -->
        <joint name="rear_caster_right_link_rear_road_right_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="rear_caster_left_link_rear_road_left_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="front_caster_right_link_front_road_right_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="front_caster_left_link_front_road_left_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>



</robot>
