<gazebo reference="camera_lower_link">
  <material>Gazebo/Black</material>
  <!-- Camara de obstaculos tipo RealSense (RGB + profundidad + nube de puntos)
       Topicos /camera_lower/image_raw, /camera_lower/depth/image_raw y
       /camera_lower/points (PointCloud2, usada por el local costmap).
       320x240 a 15 Hz para no cargar la simulacion -->
  <!-- OJO no escribir dos puntos seguidos de espacio en comentarios del URDF,
       gazebo_ros2_control lo lee como YAML y falla al cargar los controladores -->
  <sensor name="camera_lower_sensor" type="depth">
    <always_on>true</always_on>
    <update_rate>15</update_rate>
    <visualize>false</visualize>
    <camera name="camera_lower">
      <horizontal_fov>1.5184364</horizontal_fov>  <!-- 87 grados como la RealSense D435 -->
      <image><width>320</width><height>240</height><format>R8G8B8</format></image>
      <clip><near>0.10</near><far>8.0</far></clip>
      <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
    </camera>
    <plugin name="camera_lower_plugin" filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>/</namespace>
        <use_sim_time>true</use_sim_time>
      </ros>
      <camera_name>camera_lower</camera_name>
      <frame_name>camera_lower_optical_link</frame_name>
      <hack_baseline>0.0</hack_baseline>
      <min_depth>0.10</min_depth>
      <max_depth>8.0</max_depth>
    </plugin>
  </sensor>
</gazebo>

