<?xml version="1.0" ?>
<robot name="uvix" xmlns:xacro="http://www.ros.org/wiki/xacro">


<gazebo reference="base_link">
  <kp>1000000.0</kp>
  <kd>10.0</kd>
</gazebo>

<gazebo reference="wheel_left_link">
  <material>Gazebo/Black</material>
  <mu1>10.0</mu1>
  <mu2>10.0</mu2>
  <slip1>0.0</slip1>
  <slip2>0.0</slip2>
  <kp>10000000.0</kp>
  <kd>10.0</kd>
  <minDepth>0.001</minDepth>
  <maxVel>0.1</maxVel>
</gazebo>

<gazebo reference="wheel_right_link">
  <material>Gazebo/Black</material>
  <mu1>10.0</mu1>
