# srv/RegisterMission.srv
uvix_interface/MissionSpec mission
---
uint16 CODE_OK=0
uint16 CODE_INVALID_SPEC=1
uint16 CODE_UNKNOWN_MISSION_TYPE=2
uint16 CODE_MISSING_PARAMETER=3
uint16 CODE_NOT_AUTHORIZED=4
uint16 CODE_IDENTITY_NOT_VERIFIED=5
uint16 CODE_DUPLICATE_REQUEST=6
uint16 CODE_BUSY=7
uint16 CODE_INTERNAL_ERROR=8

bool accepted
uint16 code
string mission_id          # vacío si fue rechazada
string message
