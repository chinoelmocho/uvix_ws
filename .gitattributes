# Finales de línea LF para el código (evita cambios fantasma entre Windows y Linux)
*.py        text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.h         text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.cfg       text eol=lf
*.rviz      text eol=lf
CMakeLists.txt text eol=lf

# Binarios: nunca convertir ni hacer diff de texto
*.stl       binary
*.STL       binary
*.dae       -diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.pgm       binary
*.posegraph binary
*.data      binary
